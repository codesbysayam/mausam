# ====================================================================
# MAUSAM - Atmospheric Intelligence Platform
# Production Environment Variables & Provider Configuration
# ====================================================================

# Primary Free Baseline (Open Data - No Key Required)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# Cache (Vercel KV / Upstash Redis REST API)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Database (PostgreSQL / Neon / Supabase / Vercel Postgres)
DATABASE_URL=
POSTGRES_URL=

# Government / National Adapters
IMD_API_KEY=
IMD_API_BASE_URL=https://api.imd.gov.in/api/v1
CPCB_API_KEY=
SACHET_FEED_URL=https://sachet.ndma.gov.in/cap_public_website/FetchAllAlertDetails
INCOIS_BASE_URL=https://incois.gov.in

# Optional Commercial Providers (Optional - Leave blank if not subscribed)
ACCUWEATHER_API_KEY=
GOOGLE_WEATHER_API_KEY=

# Server-Side AI Assistant
GEMINI_API_KEY=

# App Environment
MAUSAM_ENV=development
