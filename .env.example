# ==========================================
# MAUSAM - MULTI-SOURCE WEATHER ARCHITECTURE
# ==========================================

# PRIMARY OFFICIAL SOURCES
IMD_API_BASE_URL=https://api.imd.gov.in/api/v1
IMD_API_KEY=
IMD_API_TOKEN=
CPCB_API_KEY=
INCOIS_API_KEY=

# OPTIONAL COMMERCIAL / SECONDARY SOURCES (Leave empty if unconfigured)
ACCUWEATHER_API_KEY=
GOOGLE_WEATHER_API_KEY=

# FREE FALLBACK ENDPOINTS (No API key required)
OPEN_METEO_ENDPOINT=https://api.open-meteo.com/v1
OPEN_METEO_AIR_QUALITY_ENDPOINT=https://air-quality-api.open-meteo.com/v1
OPEN_METEO_GEOCODING_ENDPOINT=https://geocoding-api.open-meteo.com/v1

# POSTGRESQL DATABASE (Production Vercel/Supabase/Neon connection URL)
POSTGRES_URL=
DATABASE_URL=

# CACHING (In-memory fallback active by default; Redis/Upstash optional)
REDIS_URL=

# PERFORMANCE & RELIABILITY
REQUEST_TIMEOUT_MS=10000
MAX_RETRIES=3
ENABLE_CACHE=true
CACHE_TTL_MS=60000

# GEMINI AI ASSISTANT (Server-side)
GEMINI_API_KEY=
APP_URL=

# SPECIALIZED SCIENTIFIC APIS (Optional)
AZURE_MAPS_KEY=
WORLDTIDES_KEY=
AMBEEDATA_API_KEY=

