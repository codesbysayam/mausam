# ==========================================
# MAUSAM - IMD CONNECTOR CONFIGURATION
# ==========================================

IMD_API_BASE_URL=https://api.imd.gov.in/api/v1

# IMD Authentication (leave empty unless IMD credentials are provided)
IMD_API_KEY=
IMD_API_TOKEN=

# Performance & Reliability
IMD_REQUEST_TIMEOUT_MS=10000
IMD_MAX_RETRIES=3

# Caching & Deduplication
IMD_ENABLE_CACHE=true
IMD_CACHE_TTL_MS=60000

# Polling Intervals
IMD_POLL_INTERVAL_MS=60000

# Logging
IMD_ENABLE_LOGGING=true

# GEMINI AI (Server-side)
GEMINI_API_KEY=
APP_URL=

# Authoritative Weather & Specialized Data Sources (Server-side secrets)
CPCB_API_KEY=
AZURE_MAPS_KEY=
WORLDTIDES_KEY=
OPEN_METEO_ENDPOINT=https://api.open-meteo.com/v1
AMBEEDATA_API_KEY=
