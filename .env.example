# ====================================================================
# MAUSAM - Atmospheric Intelligence Platform
# Production Environment Variables & Provider Configuration Template
# ====================================================================

# 1. Primary PostgreSQL Database (Neon / Supabase / Vercel Postgres)
DATABASE_URL=
POSTGRES_URL=

# 2. Redis Persistent Cache (Upstash Redis REST API / Vercel KV)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# 3. Government / National Adapters
IMD_ENABLED=true
IMD_API_BASE_URL=https://city.imd.gov.in
IMD_API_KEY=

CPCB_ENABLED=true
CPCB_API_KEY=

SACHET_ENABLED=true
SACHET_FEED_URL=https://sachet.ndma.gov.in/cap_public_website/FetchAllAlertDetails

INCOIS_ENABLED=true
INCOIS_BASE_URL=https://incois.gov.in

RADAR_ENABLED=true

# 4. Optional Commercial Providers (Leave empty if not subscribed)
ACCUWEATHER_API_KEY=
GOOGLE_WEATHER_API_KEY=

# 5. Server-Side AI Assistant (Gemini API)
GEMINI_API_KEY=

# 6. App Environment
MAUSAM_ENV=production
